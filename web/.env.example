# Local Windows/MySQL example. URL-encode special characters in the password.
DATABASE_URL=mysql://quadrapass_local:SUBSTITUA_PELA_SENHA@127.0.0.1:3306/quadrapass_dev_20261113
TIDB_ENABLE_SSL=false
PORT=3000
ALLOWED_ORIGINS=

# Optional TiDB CA (base64 PEM); leave empty for TiDB Cloud Starter/Essential.
# TIDB_CA_CERT_BASE64=
# DB_CONNECTION_LIMIT=10
# DB_MAX_IDLE=10
# DB_IDLE_TIMEOUT_MS=240000

# Local-only admin bypass. Enabled only with NODE_ENV=development and loopback requests.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=DEFINA_UMA_SENHA_LOCAL

# Configure only when a valid Manus OAuth application is available.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
OWNER_OPEN_ID=
